{
  "name": "stackstorm-backend",
  "version": "1.0.0",
  "description": "StackStorm Backend REST API Service for Dickwella Fashion Corner",
  "main": "src/server.js",
  "private": true,
  "scripts": {
    "start": "node src/server.js",
    "lint": "eslint src/ tests/",
    "lint:fix": "eslint src/ tests/ --fix",
    "format": "prettier --write \"src/**/*.js\" \"tests/**/*.js\"",
    "format:check": "prettier --check \"src/**/*.js\" \"tests/**/*.js\"",
    "test": "jest --runInBand",
    "test:coverage": "jest --coverage"
  },
  "keywords": [
    "stackstorm",
    "ecommerce",
    "dickwella-fashion-corner",
    "express",
    "postgresql",
    "redis"
  ],
  "author": "StackStorm Engineering Team (Amarawickrama R.H., S. Thanoogithan, B.K. Pabasara, Lakshani A.T.)",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "eslint": "^8.57.1",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.6",
    "jest": "^30.5.2",
    "prettier": "^3.9.9",
    "supertest": "^7.3.1"
  }
}
