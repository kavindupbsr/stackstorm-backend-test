# Application Environment & Server Port
NODE_ENV=development
PORT=5000

# PostgreSQL 17 Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=stackstorm_dev
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME_TEST=stackstorm_test

# Redis 7 In-Memory Cache & Session Store
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Security & Tokens
JWT_ACCESS_SECRET=supersecret_stackstorm_access_jwt_key_2026
JWT_REFRESH_SECRET=supersecret_stackstorm_refresh_jwt_key_2026
BCRYPT_WORK_FACTOR=12

# Client & CORS
CLIENT_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
